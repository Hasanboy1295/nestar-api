# MongoDB connection strings (dev / production)
MONGO_DEV=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Nestar
MONGO_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/NestarProd

# JWT signing secret
SECRET_TOKEN=change-me

# Comma separated list of allowed CORS origins (frontend URL)
ALLOWED_ORIGINS=http://localhost:3000
